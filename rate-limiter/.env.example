# Copy this file to `.env` and adjust as needed.
# See docs/ACCOUNTS_AND_CREDENTIALS.md for what each value means and where
# it should come from in each environment.

NODE_ENV=development
PORT=3000

# 'memory' for local/dev (no Redis needed) or 'redis' for production/distributed.
RATE_LIMIT_BACKEND=memory

# Only used when RATE_LIMIT_BACKEND=redis.
# Local docker-compose default shown below; replace with your managed
# Redis connection string (Redis Cloud / Upstash / ElastiCache) in prod.
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000

# Default token bucket policy (overridable per-tier/per-endpoint in
# src/policies/RateLimitPolicy.js).
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SEC=5

# 'ip' | 'user' | 'apiKey' — fallback identity strategy when no API key
# or authenticated user is present on the request.
RATE_LIMIT_IDENTITY_STRATEGY=ip

# Set to 'true' ONLY if this app sits behind a proxy/load balancer you
# control that itself sanitizes X-Forwarded-For. See middleware comments.
TRUST_PROXY=false

LOG_LEVEL=info
